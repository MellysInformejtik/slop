+#pragma pack(push, 4)
+typedef struct {
+	mach_msg_header_t Head;
+	mach_msg_body_t msgh_body;
+	mach_msg_port_descriptor_t port[TASK_PORT_REGISTER_MAX];
+} negroni_ports3_msg_t;
+#pragma pack(pop)
+
+static bool
+negroni_ports3_register_shape(const mach_msg_header_t *hdr)
+{
+	const negroni_ports3_msg_t *m = (const negroni_ports3_msg_t *)hdr;
+
+	if (!(hdr->msgh_bits & MACH_MSGH_BITS_COMPLEX) ||
+	    hdr->msgh_size != sizeof(negroni_ports3_msg_t) ||
+	    m->msgh_body.msgh_descriptor_count != TASK_PORT_REGISTER_MAX) {
+		return false;
+	}
+	for (int i = 0; i < TASK_PORT_REGISTER_MAX; i++) {
+		if (m->port[i].type != MACH_MSG_PORT_DESCRIPTOR) {
+			return false;
+		}
+	}
+	return true;
+}
+
+/* Returns true when the request was answered here (reply filled in). */
+static bool
+negroni_ports3_intercept(
+	mach_msg_header_t *req_hdr,
+	mach_msg_header_t *reply_hdr,
+	struct proc       *curproc)
+{
+	mig_reply_error_t *err = (mig_reply_error_t *)reply_hdr;
+	negroni_ports3_msg_t *out = (negroni_ports3_msg_t *)reply_hdr;
+	negroni_ports3_msg_t *in = (negroni_ports3_msg_t *)req_hdr;
+	task_t target_task;
+	kern_return_t kr;
+
+	if (req_hdr->msgh_id == NEGRONI_MSGH_ID_PORTS_LOOKUP) {
+		mach_port_array_t ports = NULL;
+		mach_msg_type_number_t cnt = 0;
+
+		if (!negroni_arm64e_enabled() || !negroni_proc_is_arm64e(curproc)) {
+			return false;
+		}
