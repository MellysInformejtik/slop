+		{ 0x3c, 0x3d }, { 0x3d, 0x3e }, { 0x3e, 0x3f }, { 0x3f, 0x40 }, { 0x40, 0x58 }, { 0x58, 0x5c }, { 0x5c, 0x64 },
+		{ 0x64, 0x65 },
+	};
+	uint32_t len = 0, id;
+	uint64_t size, mask;
+	uint8_t *in = negroni_struct_in(args, &len);
+	NegroniSurface *s;
