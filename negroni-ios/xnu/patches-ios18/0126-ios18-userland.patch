+negroni_proc_is_arm64e(struct proc *p)
+{
+	return p != PROC_NULL && p->p_cputype == CPU_TYPE_ARM64 &&
+	       (p->p_cpusubtype & ~CPU_SUBTYPE_MASK) == CPU_SUBTYPE_ARM64E;
+}
