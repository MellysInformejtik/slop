new file mode 100644
index 0000000..df76f28
--- /dev/null
+++ b/iokit/Kernel/arm/NegroniBusy.cpp
@@ -0,0 +1,54 @@
+/*
+ * After ios-topaz 0127 (MakrSas/ios-topaz): boot-arg negronibusy=N prints, N seconds after the framebuffer starts and every
+ * 30 s after, every IOService that is still busy. configd (InterfaceNamer) waits for IOKit to
+ * quiesce before it names network interfaces, and everyone who lists interfaces waits for that.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(NEGRONI)
+#include <IOKit/IOLib.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IORegistryEntry.h>
+#include <kern/thread.h>
+#include <pexpert/pexpert.h>
+
+static uint32_t negroni_busy_secs;
+
+static void
+negroni_busy_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	IOSleep(negroni_busy_secs * 1000);
+	for (int round = 0; round < 10; round++) {
+		unsigned busy = 0;
+		IORegistryIterator *it = IORegistryIterator::iterateOver(gIOServicePlane, kIORegistryIterateRecursively);
+		if (it != NULL) {
+			IORegistryEntry *e;
+			while ((e = it->getNextObject()) != NULL) {
+				IOService *s = OSDynamicCast(IOService, e);
+				if (s != NULL && s->getBusyState() != 0) {
+					busy++;
+					IOLog("NEGRONI BUSY: %s <%s> busy %u\n", s->getName(), s->getMetaClass()->getClassName(), (unsigned)s->getBusyState());
+				}
+			}
+			it->release();
+		}
+		IOLog("NEGRONI BUSY: round %d: %u busy services\n", round, busy);
+		IOSleep(30000);
+	}
+	thread_terminate(current_thread());
+}
+
+extern "C" void
+negroni_busy_init(void)
+{
+	thread_t thread;
+	if (!PE_parse_boot_argn("negronibusy", &negroni_busy_secs, sizeof(negroni_busy_secs)) || negroni_busy_secs == 0) {
+		return;
+	}
+	if (kernel_thread_start(negroni_busy_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#else
+extern "C" void negroni_busy_init(void) {}
+#endif
