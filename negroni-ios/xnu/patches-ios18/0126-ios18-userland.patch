+	if (in == NULL || len < 0x84) {
+		if (in != NULL) {
+			IOFreeData(in, len);
+		}
+		return kIOReturnBadArgument;
+	}
+	memcpy(&size, in + 0x70, 8);
+	memcpy(&mask, in + 0x78, 8);
+	memcpy(&id, in + 0x80, 4);
+	if (size > NEGRONI_SURFACE_BULK_SIZE || (s = negroni_surface_copy(id)) == NULL) {
+		IOFreeData(in, len);
+		return size > NEGRONI_SURFACE_BULK_SIZE ? kIOReturnBadArgument : kIOReturnNotFound;
+	}
+	uint8_t *bulk = (uint8_t *)s->state->getBytesNoCopy() + NEGRONI_SURFACE_STATE_BULK;
+	IOLockLock(negroni_surface_lock);
+	for (unsigned i = 0; i < 15; i++) {
+		if ((mask & (1ull << i)) && field[i][1] <= size) {
+			memcpy(bulk + field[i][0], in + field[i][0], field[i][1] - field[i][0]);
+		}
+	}
+	IOLockUnlock(negroni_surface_lock);
+	IOFreeData(in, len);
