+	NegroniSurface *s;
+	OSSerialize *ser = NULL;
+	uint32_t length = 0;
+
+	if (in == NULL) {
+		return kIOReturnBadArgument;
+	}
+	if (len < 9 || (selector != kNegroniSurfaceSetValue && in[len - 1] != 0)) {
+		IOFreeData(in, len);
+		return kIOReturnBadArgument;
+	}
+	memcpy(&id, in, sizeof(id));
+	s = negroni_surface_copy(id);
+	if (s == NULL) {
+		IOFreeData(in, len);
+		return kIOReturnNotFound;
+	}
+	OSObject *obj = selector == kNegroniSurfaceSetValue ? OSUnserializeXML((const char *)in + 8, len - 8) : NULL;
+	IOLockLock(negroni_surface_lock);
