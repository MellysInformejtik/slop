--- /dev/null
+++ b/iokit/Kernel/arm/NegroniAccelerator.h
@@ -0,0 +1,17 @@
+/*
+ * NEGRONI: the graphics accelerator's service class. QuartzCore and Metal look for exactly one
+ * IOAcceleratorES (IOServiceMatching), read MetalPluginName / MetalPluginClassName from it and load
+ * /System/Library/Extensions/<MetalPluginName>.bundle. NegroniFramebuffer publishes an empty one
+ * (no plugin: Metal passes over it) unless the GPU is kept on; then NegroniGPU publishes
+ * AGXAccelerator, the Adreno's, with the NativeAdrenoMetal plugin.
+ */
+#ifndef _NEGRONI_ACCELERATOR_H
+#define _NEGRONI_ACCELERATOR_H
+
+#include <IOKit/IOService.h>
+
+class IOAcceleratorES : public IOService {
+	OSDeclareDefaultStructors(IOAcceleratorES);
+};
+
+#endif
