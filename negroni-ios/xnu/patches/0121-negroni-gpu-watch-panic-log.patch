diff --git a/bsd/dev/negroni_adreno.c b/bsd/dev/negroni_adreno.c
index 1e145df..1ab74d7 100644
--- a/bsd/dev/negroni_adreno.c
+++ b/bsd/dev/negroni_adreno.c
@@ -61,6 +61,7 @@
 #include <pexpert/pexpert.h>
 #include <vm/vm_kern.h>
 #include <arm/caches_internal.h>
+#include <kern/thread.h>
 
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 extern const void *negroni_fw_get(const char *name, uint32_t *size);
@@ -2291,6 +2292,61 @@ negroni_gpu_report(const char *why)
 	space_faulted(&core_space);
 }
 
+/*
+ * Keep mode, watched (boot-arg negroniadreno_watch, default 1 with negroniadreno_keep=1): once a
+ * second, what the GPU block left running does by itself -- the GMU's always-on counter, the CX and
+ * GX power domains, the GPU RSC, the GMU's queue to us (q[1]) and its log's first word, the 3D
+ * core's ring pointers, status and faults (read only while GX has power: its registers are in GX),
+ * and the SMMU's global and two context fault registers. A line whenever one of them changes, and
+ * one every ten seconds regardless, so the log shows the last state before anything goes wrong.
+ */
+static void
+gpu_watch(void *arg __unused, wait_result_t wr __unused)
+{
+	uint32_t last[14] = { 0 };
+	bool first = true;
+
+	for (uint32_t second = 1;; second++) {
+		uint32_t now[14];
+		struct hfi_queue_header *q = (struct hfi_queue_header *)(gmu_hfi.memory + sizeof(struct hfi_table_header));
+		bool gx;
+
+		assert_wait_timeout((event_t)&gpu_kept, THREAD_UNINT, 1000, NSEC_PER_MSEC);
+		thread_block(THREAD_CONTINUE_NULL);
+		to_memory(gmu_hfi.memory, 4096);
+		to_memory(gmu_log.memory, 64);
+		now[0] = rd(gpucc + GPUCC_CX_GDSCR);
+		now[1] = rd(gpucc + GPUCC_GX_GDSCR);
+		gx = (now[1] & GDSC_PWR_ON) != 0;
+		now[2] = rd(rscc + RSCC_STATUS0);
+		now[3] = q[1].write_index;
+		now[4] = *(volatile uint32_t *)gmu_log.memory;
+		now[5] = gx ? rd(gpu_regs + GPU_WORD(REG_CP_RB_RPTR)) : ~0u;
+		now[6] = gx ? rd(gpu_regs + GPU_WORD(REG_RBBM_STATUS)) : ~0u;
+		now[7] = gx ? rd(gpu_regs + GPU_WORD(REG_CP_HW_FAULT)) : ~0u;
+		now[8] = gx ? rd(gpu_regs + GPU_WORD(REG_RBBM_INT_0_STATUS)) : ~0u;
+		now[9] = rd(smmu + SMMU_SGFSR);
+		now[10] = rd(smmu + smmu_cb(&core_space) + SMMU_CB_FSR);
+		now[11] = rd(smmu + smmu_cb(&gmu_space) + SMMU_CB_FSR);
+		now[12] = rd(gmu + GMU_REG(GMU_HFI_CTRL_STATUS));
+		now[13] = *(volatile uint32_t *)(core_scratch.memory + 0x80);  /* the core's copy of its ring rptr */
+		if (first || memcmp(now, last, sizeof(now)) != 0 || second % 10 == 0) {
+			printf("NEGRONI GPU WATCH %u s: AO %#x CX %#x GX %#x RSC %#x q1w %u log0 %#x | rptr %#x RBBM %#x "
+			    "HW_FAULT %#x INT0 %#x | SGFSR %#x FSR core %#x gmu %#x | HFI %#x rptr-copy %#x\n", second,
+			    rd(gmu + GMU_REG(GMU_AO_COUNTER_L)), now[0], now[1], now[2], now[3], now[4], now[5], now[6],
+			    now[7], now[8], now[9], now[10], now[11], now[12], now[13]);
+			if (now[10] & SMMU_FSR_ALL) {
+				space_faulted(&core_space);
+			}
+			if (now[11] & SMMU_FSR_ALL) {
+				space_faulted(&gmu_space);
+			}
+			memcpy(last, now, sizeof(now));
+			first = false;
+		}
+	}
+}
+
 /* After step 22 with negroniadreno_keep=1: the fences start at 0 and the service is made. */
 static void
 gpu_keep(void)
@@ -2305,6 +2361,13 @@ gpu_keep(void)
 	gpu_kept = true;
 	snprintf(negroni_gpu_badge, sizeof(negroni_gpu_badge), "GPU KEPT");
 	printf("NEGRONI GPU: the 3D core stays on; RedwoodGPU for programs\n");
+	uint32_t watch = 1;
+	thread_t thread;
+
+	(void)PE_parse_boot_argn("negroniadreno_watch", &watch, sizeof(watch));
+	if (watch && kernel_thread_start(gpu_watch, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
 	NegroniGPUStart();
 }
 
diff --git a/bsd/dev/negroni_ufs.c b/bsd/dev/negroni_ufs.c
index 2508cb8..76b4d9d 100644
--- a/bsd/dev/negroni_ufs.c
+++ b/bsd/dev/negroni_ufs.c
@@ -933,54 +933,90 @@ struct negroni_log_header {
 	uint64_t total, seq;
 };
 
-static void
-negroni_log_thread(__unused void *arg, __unused wait_result_t wr)
+/* The ring from `flushed` to `total` onto the partition, and the header. With the lock held (or in a panic). */
+static int
+negroni_log_write(uint64_t flushed, uint64_t total, uint64_t seq)
 {
 	uint64_t base = su.first_block + su.nblocks - NEGRONI_LOG_BLOCKS;
-	uint64_t flushed = 0, seq = 0;
 	void *bounce = (void *)(su.dma + DMA_BOUNCE);
+	uint64_t pos = total - flushed >= NEGRONI_LOG_SIZE ? total - NEGRONI_LOG_SIZE : flushed;
+	int error = 0;
+
+	while (pos < total && !error) {
+		uint32_t off = (uint32_t)(pos % NEGRONI_LOG_SIZE);
+		uint32_t blk = off / UFS_BLOCK;
+		uint64_t need = ((uint64_t)off % UFS_BLOCK + (total - pos) + UFS_BLOCK - 1) / UFS_BLOCK;
+		uint32_t n = (uint32_t)MIN(MIN(need, (uint64_t)(NEGRONI_LOG_SIZE / UFS_BLOCK - blk)),
+		    (uint64_t)(BOUNCE_SIZE / UFS_BLOCK));
+		memcpy(bounce, negroni_log_ring + (uint64_t)blk * UFS_BLOCK, n * UFS_BLOCK);
+		error = ufs_write_blocks(base + 1 + blk, n);
+		pos += (uint64_t)(blk + n) * UFS_BLOCK - off;
+	}
+	if (!error) {
+		struct negroni_log_header h = {
+			.magic = { 'S', 'W', 'E', 'E', 'T', 'L', 'O', 'G' },
+			.version = 1, .size = NEGRONI_LOG_SIZE, .total = total, .seq = seq,
+		};
+		bzero(bounce, UFS_BLOCK);
+		memcpy(bounce, &h, sizeof(h));
+		error = ufs_write_blocks(base, 1);
+	}
+	if (!error) {
+		error = ufs_sync_cache();
+	}
+	return error;
+}
+
+static bool negroni_log_running;
+static uint64_t negroni_log_flushed, negroni_log_seq;
 
+static void
+negroni_log_thread(__unused void *arg, __unused wait_result_t wr)
+{
 	printf("NEGRONI LOG: console log to the last %u KiB of the partition (block 0x%llx)\n",
-	    NEGRONI_LOG_BLOCKS * UFS_BLOCK >> 10, base);
+	    NEGRONI_LOG_BLOCKS * UFS_BLOCK >> 10, su.first_block + su.nblocks - NEGRONI_LOG_BLOCKS);
+	negroni_log_running = true;
 	for (;;) {
 		(void)tsleep(&negroni_log_chan, PZERO, "negronilog", hz * (int)negroni_log_secs);
 		uint64_t total = os_atomic_load(&negroni_log_total, relaxed);
-		if (total == flushed) {
+		if (total == negroni_log_flushed) {
 			continue;
 		}
-		uint64_t pos = total - flushed >= NEGRONI_LOG_SIZE ? total - NEGRONI_LOG_SIZE : flushed;
-		int error = 0;
-
 		lck_mtx_lock(&negroni_ufs_lock);
-		while (pos < total && !error) {
-			uint32_t off = (uint32_t)(pos % NEGRONI_LOG_SIZE);
-			uint32_t blk = off / UFS_BLOCK;
-			uint64_t need = ((uint64_t)off % UFS_BLOCK + (total - pos) + UFS_BLOCK - 1) / UFS_BLOCK;
-			uint32_t n = (uint32_t)MIN(MIN(need, (uint64_t)(NEGRONI_LOG_SIZE / UFS_BLOCK - blk)),
-			    (uint64_t)(BOUNCE_SIZE / UFS_BLOCK));
-			memcpy(bounce, negroni_log_ring + (uint64_t)blk * UFS_BLOCK, n * UFS_BLOCK);
-			error = ufs_write_blocks(base + 1 + blk, n);
-			pos += (uint64_t)(blk + n) * UFS_BLOCK - off;
-		}
-		if (!error) {
-			struct negroni_log_header h = {
-				.magic = { 'S', 'W', 'E', 'E', 'T', 'L', 'O', 'G' },
-				.version = 1, .size = NEGRONI_LOG_SIZE, .total = total, .seq = ++seq,
-			};
-			bzero(bounce, UFS_BLOCK);
-			memcpy(bounce, &h, sizeof(h));
-			error = ufs_write_blocks(base, 1);
-		}
-		if (!error) {
-			error = ufs_sync_cache();
-		}
+		int error = negroni_log_write(negroni_log_flushed, total, ++negroni_log_seq);
 		lck_mtx_unlock(&negroni_ufs_lock);
 		if (error) {
 			printf("NEGRONI LOG: write failed (%d), stopping\n", error);
+			negroni_log_running = false;
 			return;
 		}
-		flushed = total;
+		negroni_log_flushed = total;
+	}
+}
+
+/*
+ * From the panic path (osfmk/arm/model_dep.c, after the backtraces): the panic log (XNU writes it
+ * to its panic buffer, not the console) into the ring, and the ring onto the partition once more.
+ * Interrupts are off, so ufs_command() spins. The UFS lock is not taken: if the flush thread was in
+ * the middle of a write, this one may meet a busy slot and time out, which costs only this write.
+ */
+void negroni_log_panic(const char *text, size_t length);
+
+void
+negroni_log_panic(const char *text, size_t length)
+{
+	static bool done;
+
+	if (done || !negroni_log_running) {
+		return;
+	}
+	done = true;
+	negroni_log_append("\nNEGRONI LOG: panic log follows\n", 32);
+	for (size_t i = 0; i < length; i += 512) {
+		negroni_log_append(text + i, (int)MIN((size_t)512, length - i));
 	}
+	negroni_log_append("\nNEGRONI LOG: end of panic log\n", 31);
+	(void)negroni_log_write(negroni_log_flushed, os_atomic_load(&negroni_log_total, relaxed), ++negroni_log_seq);
 }
 
