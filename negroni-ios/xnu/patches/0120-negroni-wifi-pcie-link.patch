+static void
+wr(vm_offset_t address, uint32_t value)
+{
+	__asm__ volatile ("str %w0, [%1]" : : "r" (value), "r" (address) : "memory");
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static void
+set(vm_offset_t address, uint32_t bits)
+{
+	wr(address, rd(address) | bits);
+}
+
+static void
+clear(vm_offset_t address, uint32_t bits)
+{
+	wr(address, rd(address) & ~bits);
+}
+
+static bool
+wait_for(vm_offset_t address, uint32_t mask, uint32_t want, uint32_t ms)
+{
+	for (uint32_t i = 0; i < 10 * ms; i++) {
+		if ((rd(address) & mask) == want) {
+			return true;
+		}
+		delay(100);
+	}
+	return (rd(address) & mask) == want;
+}
