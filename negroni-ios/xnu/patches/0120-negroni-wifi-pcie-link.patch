-static bool (*const steps[])(void) = { step_gcc, step_pins, step_rails, step_pcie };
+static bool
+step_power(void)
+{
+	announce("switch on the PCIe0 GDSC and clocks (GCC writes)");
+	clear(gcc + GCC_PCIE_0_GDSCR, 1u);                     /* SW_COLLAPSE off */
+	if (!wait_for(gcc + GCC_PCIE_0_GDSCR, GDSC_PWR_ON, GDSC_PWR_ON, 10)) {
+		printf("NEGRONI WIFI: 5 stop: PCIE_0_GDSC does not come on (%#x)\n", rd(gcc + GCC_PCIE_0_GDSCR));
+		return false;
+	}
+	wr(gcc + GCC_PCIE_0_PIPE_MUX, 2);                       /* XO until the PHY makes the pipe clock */
+	wr(gcc + GCC_PCIE_0_RCHNG_RCGR + 4, 1u << 8 | (2 * 6 - 1));     /* GPLL0 main / 6 = 100 MHz */
+	set(gcc + GCC_PCIE_0_RCHNG_RCGR, 1u);
+	wait_for(gcc + GCC_PCIE_0_RCHNG_RCGR, 1u, 0, 10);
+	set(gcc + GCC_VOTE_0, GCC_VOTE_0_PCIE0);
+	set(gcc + GCC_VOTE_2, GCC_VOTE_2_PCIE0 & ~(1u << 4));  /* the pipe clock after the PHY (step 7) */
+	set(gcc + GCC_PCIE_0_CLKREF_EN, 1u);
+	delay(100);
+	bool ok = !(rd(gcc + GCC_PCIE_0_CFG_AHB) & CBCR_OFF) && !(rd(gcc + GCC_PCIE_0_AUX) & CBCR_OFF);
+	printf("NEGRONI WIFI: 5 GDSC %#x, CFG AHB %#x, AUX %#x, MSTR %#x, SLV %#x, RCHNG cfg %#x: %s\n",
+	    rd(gcc + GCC_PCIE_0_GDSCR), rd(gcc + GCC_PCIE_0_CFG_AHB), rd(gcc + GCC_PCIE_0_AUX),
+	    rd(gcc + GCC_PCIE_0_MSTR_AXI), rd(gcc + GCC_PCIE_0_SLV_AXI), rd(gcc + GCC_PCIE_0_RCHNG_RCGR + 4),
+	    ok ? "running" : "NOT running");
+	powered = ok;
+	return ok;
+}
+
+static void
+gpio_out(uint32_t pin, bool high)
+{
+	wr(tlmm + TLMM_PIN(pin) + 4, high ? 2u : 0);
+	wr(tlmm + TLMM_PIN(pin), 7u << 6 | 1u << 9);           /* gpio function, 16 mA, no pull, output */
+}
+
+static bool
+step_chip_on(void)
+{
+	announce("hold PERST low and drive WLAN_EN high (TLMM writes)");
+	gpio_out(PERST_PIN, false);
+	gpio_out(WLAN_EN_PIN, true);
+	delay(50000);
+	printf("NEGRONI WIFI: 6 WLAN_EN out %u, PERST out %u, SW_CTRL in %u\n", (rd(tlmm + TLMM_PIN(WLAN_EN_PIN) + 4) >> 1) & 1,
+	    (rd(tlmm + TLMM_PIN(PERST_PIN) + 4) >> 1) & 1, rd(tlmm + TLMM_PIN(82) + 4) & 1);
+	return true;
+}
+
+static void
+bcr_pulse(uint32_t off)
+{
+	wr(gcc + off, 1);
+	delay(1000);
+	wr(gcc + off, 0);
+	delay(1000);
+}
+
+static bool
+step_phy(void)
+{
+	uint32_t status;
+
+	if (!powered) {
+		printf("NEGRONI WIFI: 7 stop: no clocks (step 5)\n");
+		return false;
+	}
+	announce("set the controller up and start the PHY (PARF and PHY writes)");
+	parf = ml_io_map(PARF_PHYS, PARF_SIZE);
+	phy = ml_io_map(PHY_PHYS, PHY_SIZE);
+	bcr_pulse(GCC_PCIE_0_BCR);
+	wr(parf + PARF_DEVICE_TYPE, 4);                         /* root complex */
+	clear(parf + PARF_PHY_CTRL, 1u);                        /* PHY_TEST_PWR_DOWN */
+	wr(parf + PARF_DBI_BASE_ADDR_V2, (uint32_t)DBI_PHYS);
+	wr(parf + PARF_DBI_BASE_ADDR_V2_HI, 0);
+	wr(parf + PARF_ATU_BASE_ADDR, (uint32_t)(DBI_PHYS + ATU_OFFSET));
+	wr(parf + PARF_ATU_BASE_ADDR_HI, 0);
+	clear(parf + PARF_SYS_CTRL, 1u << 29);                  /* MAC_PHY_POWERDOWN_IN_P2_D_MUX_EN */
+	set(parf + PARF_MHI_CLOCK_RESET_CTRL, 1u << 4);         /* BYPASS */
+	clear(parf + PARF_PM_CTRL, 1u << 5);                    /* REQ_NOT_ENTR_L1 */
+	set(parf + PARF_AXI_MSTR_WR_ADDR_HALT_V2, 1u << 31);
+
+	wr(gcc + GCC_PCIE_0_PHY_BCR, 1);
+	wr(gcc + GCC_PCIE_0_NOCSR_COM_PHY_BCR, 1);
+	delay(300);
+	wr(gcc + GCC_PCIE_0_PHY_BCR, 0);
+	set(phy + PCS_POWER_DOWN_CONTROL, 1u | 2u);             /* SW_PWRDN | REFCLK_DRV_DSBL */
+	for (unsigned i = 0; i < sizeof(phy_init) / sizeof(phy_init[0]); i++) {
+		wr(phy + phy_init[i][0], phy_init[i][1]);
+	}
+	wr(gcc + GCC_PCIE_0_NOCSR_COM_PHY_BCR, 0);
+	clear(phy + PCS_SW_RESET, 1u);
+	set(phy + PCS_START_CONTROL, 1u | 2u);                  /* SERDES_START | PCS_START */
+	delay(1200);
+	wr(gcc + GCC_PCIE_0_PIPE_MUX, 0);
+	set(gcc + GCC_VOTE_2, 1u << 4);                         /* pipe clock */
+	wait_for(phy + PCS_PCS_STATUS1, 1u << 6, 0, 20);
+	status = rd(phy + PCS_PCS_STATUS1);
+	printf("NEGRONI WIFI: 7 PHY PCS_STATUS1 %#x (%s), pipe %#x\n", status, (status & (1u << 6)) ? "NOT ready" : "ready",
+	    rd(gcc + GCC_PCIE_0_PIPE));
+	controller = !(status & (1u << 6));
+	return controller;
+}
+
+static void
+atu(vm_offset_t base, unsigned index, uint32_t type, uint64_t from, uint64_t limit, uint64_t to)
+{
+	vm_offset_t r = base + ATU_OFFSET + ((vm_offset_t)index << 9);
+
+	wr(r + 0x08, (uint32_t)from);
+	wr(r + 0x0c, (uint32_t)(from >> 32));
+	wr(r + 0x10, (uint32_t)limit);
+	wr(r + 0x20, (uint32_t)(limit >> 32));
+	wr(r + 0x14, (uint32_t)to);
+	wr(r + 0x18, (uint32_t)(to >> 32));
+	wr(r + 0x00, type);
+	wr(r + 0x04, 1u << 31);
+}
+
+static bool
+step_link(void)
+{
+	uint32_t status = 0;
+
+	if (!controller) {
+		printf("NEGRONI WIFI: 8 stop: no PHY (step 7)\n");
+		return false;
+	}
+	announce("make the root port a bridge, map bus 1, release PERST and train the link");
+	dbi = ml_io_map(DBI_PHYS, DBI_SIZE);
+	set(dbi + 0x8bc, 1u);                                   /* DBI_RO_WR_EN */
+	wr(dbi + 0x08, (rd(dbi + 0x08) & 0xff) | 0x0604u << 16);        /* PCI-to-PCI bridge */
+	clear(dbi + 0x70 + 0x14, 1u << 6);                      /* no hot plug */
+	clear(dbi + 0x8bc, 1u);
+	wr(dbi + 0x10, 0);
+	wr(dbi + 0x14, 0);
+	wr(dbi + 0x18, 0x00010100);                             /* primary 0, secondary 1, subordinate 1 */
+	set(dbi + 0x04, 2u | 4u);                               /* memory, bus master */
+	atu(dbi, 0, 4, CFG_BUS1_PHYS, CFG_BUS1_PHYS + 0xfffff, 1ull << 24);     /* CFG0 to bus 1 */
+	atu(dbi, 1, 0, MEM_BASE, MEM_LIMIT, MEM_BASE);
+	delay(100000);                                          /* PERST held 100 ms */
+	gpio_out(PERST_PIN, true);
+	delay(1000);
+	set(parf + PARF_LTSSM, 1u << 8);
+	for (int i = 0; i < 100; i++) {
+		status = rd(dbi + 0x80);
+		if (status & (1u << 29)) {
+			break;
+		}
+		delay(10000);
+	}
+	printf("NEGRONI WIFI: 8 link %s: LNKSTA %#x (gen %u x%u), LTSSM %#x\n", (status & (1u << 29)) ? "UP" : "down",
+	    status >> 16, (status >> 16) & 0xf, (status >> 20) & 0x3f, rd(parf + PARF_LTSSM));
+	linked = (status & (1u << 29)) != 0;
+	return linked;
+}
+
+static bool
+step_chip(void)
+{
+	uint32_t id;
+
+	if (!linked) {
+		printf("NEGRONI WIFI: 9 stop: no link (step 8)\n");
+		return false;
+	}
+	announce("read the chip's config space on bus 1");
+	cfg_bus1 = ml_io_map(CFG_BUS1_PHYS, 0x1000);
+	id = rd(cfg_bus1);
+	printf("NEGRONI WIFI: 9 bus 1 device %04x:%04x, class %#x, BAR0 %#x, BAR1 %#x\n", id & 0xffff, id >> 16,
+	    rd(cfg_bus1 + 0x08) >> 8, rd(cfg_bus1 + 0x10), rd(cfg_bus1 + 0x14));
+	if (id == CHIP_ID) {
+		printf("NEGRONI WIFI: 9 THE QCA6490 ANSWERS ON PCIe\n");
+	}
+	return id == CHIP_ID;
+}
+
+static bool (*const steps[])(void) = {
+	step_gcc, step_pins, step_rails, step_pcie, step_power, step_chip_on, step_phy, step_link, step_chip,
+};
 
