+/*
+ * kRedwoodShow: the caller's picture onto the panel, row by row, clipped to the panel. The boot
+ * framebuffer is mapped write-combined once; whatever backboardd presents next draws over it.
+ */
+IOReturn
+RedwoodGPUUserClient::show(const struct redwood_show * request)
+{
+	static vm_offset_t panel;
+	PE_Video video;
+
+	PE_current_console(&video);
+	if (video.v_baseAddr == 0 || video.v_rowBytes < video.v_width * 4) {
+		return kIOReturnNotReady;
+	}
+	if (request->pixels == 0 || request->row_bytes < (uint64_t) request->width * 4) {
+		return kIOReturnBadArgument;
+	}
+	if (panel == 0) {
+		IOMemoryDescriptor * fb = IOMemoryDescriptor::withPhysicalAddress((IOPhysicalAddress) video.v_baseAddr,
+		    (IOByteCount) video.v_rowBytes * video.v_height, kIODirectionInOut);
+		IOMemoryMap * map = fb ? fb->map(kIOMapWriteCombineCache) : NULL;   /* kept for good */
+
+		OSSafeReleaseNULL(fb);
+		if (map == NULL) {
+			return kIOReturnNoMemory;
+		}
+		panel = (vm_offset_t) map->getVirtualAddress();
+	}
+	uint32_t rows = MIN(request->height, (uint32_t) video.v_height);
+	vm_size_t bytes = (vm_size_t) MIN(request->width, (uint32_t) video.v_width) * 4;
+	for (uint32_t y = 0; y < rows; y++) {
+		if (copyin((user_addr_t) (request->pixels + (uint64_t) y * request->row_bytes),
+		    (void *) (panel + (vm_offset_t) y * video.v_rowBytes), bytes) != 0) {
+			return kIOReturnBadArgument;
+		}
+	}
+	return kIOReturnSuccess;
+}
