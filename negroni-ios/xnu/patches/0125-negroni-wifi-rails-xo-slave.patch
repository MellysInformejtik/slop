+/*
+ * The chip's rails voted on through RPMh (Linux qcom-rpmh-regulator: VRM mV at +0, enable at +4 of the
+ * cmd-db address), from the apps RSC DRV 2 on its last active TCS (2) when idle, as Mu's NegroniPcieDxe
+ * does; voltages from the vendor DT qcom,cnss-qca6490. Without them SW_CTRL stays 0 and the link never
+ * leaves Detect.
+ */
+#define RSC_DRV2_PHYS           0x17a20000UL
+#define RSC_DRV_SIZE            0x10000UL
+#define RSC_TCS_BASE            0xd00u
+#define RSC_TCS                 2u
+
+static const struct { const char *name; uint32_t mv; } wifi_rails[] = {
+	{ "smpb10", 1800 }, { "smpb11", 966 }, { "smpb12", 1350 }, { "smpc1", 1900 }, { "smpe2", 1012 },
+};
+
+static bool
+rails_on(void)
+{
+	vm_offset_t rsc = ml_io_map(RSC_DRV2_PHYS, RSC_DRV_SIZE), tcs;
+	uint32_t addr[5], v3, cmd_size, control, status, enable, msgid, caddr, cdata, cstatus, n = 0, i;
+
+	for (i = 0; i < 5; i++) {
+		if (cmd_db_lookup(wifi_rails[i].name, &addr[i]) != 0) {
+			printf("NEGRONI WIFI: 6 rail %s not in cmd-db\n", wifi_rails[i].name);
+			return false;
+		}
+	}
+	v3 = ((rd(rsc) >> 16) & 0xff) >= 3;     /* rpmh_rsc_reg_offset_ver_3_0 / _2_7 */
+	cmd_size = v3 ? 24 : 20;
+	control = v3 ? 0x24 : 0x14;
+	status = v3 ? 0x28 : 0x18;
+	enable = v3 ? 0x2c : 0x1c;
+	msgid = v3 ? 0x34 : 0x30;
+	caddr = v3 ? 0x38 : 0x34;
+	cdata = v3 ? 0x3c : 0x38;
+	cstatus = v3 ? 0x40 : 0x3c;
+	tcs = rsc + RSC_TCS_BASE + 672 * RSC_TCS;
+	if (!(rd(tcs + status) & 1)) {
+		printf("NEGRONI WIFI: 6 RSC TCS %u busy\n", RSC_TCS);
+		return false;
+	}
+	for (i = 0; i < 5; i++, n++) {
+		wr(tcs + msgid + cmd_size * n, 8u | 1u << 16 | 1u << 8);
+		wr(tcs + caddr + cmd_size * n, addr[i]);
+		wr(tcs + cdata + cmd_size * n, wifi_rails[i].mv);
+	}
+	for (i = 0; i < 5; i++, n++) {
+		wr(tcs + msgid + cmd_size * n, 8u | 1u << 16 | 1u << 8);
+		wr(tcs + caddr + cmd_size * n, addr[i] + 4);
+		wr(tcs + cdata + cmd_size * n, 1);
+	}
+	wr(tcs + enable, (1u << n) - 1);
+	clear(tcs + control, 1u << 24);
+	clear(tcs + control, 1u << 16);
+	wr(tcs + control, 1u << 16);
+	wr(tcs + control, 1u << 16 | 1u << 24);
+	for (i = 0; i < 100; i++) {
+		uint32_t done = 0;
+		for (uint32_t c = 0; c < n; c++) {
+			done += (rd(tcs + cstatus + cmd_size * c) >> 16) & 1;
+		}
+		if (done == n) {
+			break;
+		}
+		delay(1000);
+	}
+	printf("NEGRONI WIFI: 6 rails: %u votes %s after %u ms (RSC v%u)\n", n, i < 100 ? "done" : "NOT done", i, v3 ? 3 : 2);
+	wr(rsc + RSC_TCS_BASE + 0x08, 1u << RSC_TCS);        /* IRQ clear */
+	clear(tcs + control, 1u << 24);
+	clear(tcs + control, 1u << 16);
+	wr(tcs + enable, 0);
+	delay(10000);
+	return i < 100;
+}
+
 static bool
 step_chip_on(void)
 {
-	announce("hold PERST low and drive WLAN_EN high (TLMM writes)");
+	announce("vote the chip's rails on (RPMh) and power it up (Linux pwrseq wcn6855: XO pin, WLAN_EN)");
+	if (!rails_on()) {
+		return false;
+	}
 	gpio_out(PERST_PIN, false);
+	gpio_out(WLAN_EN_PIN, false);
+	gpio_out(XO_CLK_PIN, false);
+	delay(10000);
+	gpio_out(XO_CLK_PIN, true);
+	delay(200);
 	gpio_out(WLAN_EN_PIN, true);
+	delay(10000);
+	gpio_out(XO_CLK_PIN, false);
 	delay(50000);
 	printf("NEGRONI WIFI: 6 WLAN_EN out %u, PERST out %u, SW_CTRL in %u\n", (rd(tlmm + TLMM_PIN(WLAN_EN_PIN) + 4) >> 1) & 1,
 	    (rd(tlmm + TLMM_PIN(PERST_PIN) + 4) >> 1) & 1, rd(tlmm + TLMM_PIN(82) + 4) & 1);
@@ -335,6 +421,8 @@ step_phy(void)
 	wr(parf + PARF_DBI_BASE_ADDR_V2_HI, 0);
 	wr(parf + PARF_ATU_BASE_ADDR, (uint32_t)(DBI_PHYS + ATU_OFFSET));
 	wr(parf + PARF_ATU_BASE_ADDR_HI, 0);
+	wr(parf + 0x358, 0);                                    /* PARF_SLV_ADDR_SPACE_SIZE_V2: without it DBI, iATU */
+	wr(parf + 0x35c, 0x80000000);                           /* and bus 1 read 0xffffffff */
 	clear(parf + PARF_SYS_CTRL, 1u << 29);                  /* MAC_PHY_POWERDOWN_IN_P2_D_MUX_EN */
 	set(parf + PARF_MHI_CLOCK_RESET_CTRL, 1u << 4);         /* BYPASS */
 	clear(parf + PARF_PM_CTRL, 1u << 5);                    /* REQ_NOT_ENTR_L1 */
